---
// Emitted as a separate file and linked only from notes with `math: true`.
import katexCss from 'katex/dist/katex.min.css?url';
import Base from './Base.astro';
import PrevNext from '../components/PrevNext.astro';
import SeriesBox from '../components/SeriesBox.astro';
import Toc from '../components/Toc.astro';
import { isoDate, seriesPosition, tagSlug, type Note, type SeriesPart } from '../lib/notes';
import { url } from '../site';

interface Props {
  note: Note;
  all: Note[];
  headings: { depth: number; slug: string; text: string }[];
}

const { note, all, headings } = Astro.props;
const { data } = note;
const date = isoDate(data.date);
const pos = seriesPosition(note, all);

// Notes outside a series link to their neighbours by date. `all` is sorted newest first.
const at = all.findIndex((n) => n.id === note.id);
const asPart = (n?: Note): SeriesPart | undefined => (n ? { order: 0, title: n.data.title, note: n } : undefined);
const prev = pos ? pos.prev : asPart(all[at + 1]);
const next = pos ? pos.next : asPart(all[at - 1]);
---

<Base title={data.title} description={data.description} section="/notes/" ogType="article">
  <Fragment slot="head">
    <meta property="article:published_time" content={data.date.toISOString()} />
    {data.math && <link rel="stylesheet" href={katexCss} />}
  </Fragment>
  <main id="main" class="wrap note">
    <article>
      <header class="nhead">
        <p class="kind"><a href={url('/notes/')}>Notes</a> / {data.type}</p>
        <h1>{data.title}</h1>
        <div class="meta">
          <time datetime={date}>{date}</time>
          {data.tags.length > 0 && (
            <span>
              {data.tags.map((tag, i) => (
                <Fragment>{i > 0 && ', '}<a href={url(`/tags/${tagSlug(tag)}/`)}>{tag}</a></Fragment>
              ))}
            </span>
          )}
        </div>
        {pos && <SeriesBox view={pos.view} index={pos.index} />}
        <Toc headings={headings} variant="inline" />
      </header>

      <div class="prose">
        <slot />
      </div>

      <PrevNext
        label={pos ? '시리즈 이동' : '글 이동'}
        prev={prev}
        next={next}
        emptyPrev={pos ? '첫 편이다' : '첫 글이다'}
        emptyNext={pos ? '마지막 편이다' : '가장 최근 글이다'}
      />
    </article>

    <Toc headings={headings} variant="side" />
  </main>
</Base>

<script is:inline>
  // Mark the section being read in the side table of contents.
  (function () {
    var links = document.querySelectorAll('.toc a');
    if (!links.length || !('IntersectionObserver' in window)) return;
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (!e.isIntersecting) return;
        links.forEach(function (a) {
          a.classList.toggle('on', decodeURIComponent(a.hash) === '#' + e.target.id);
        });
      });
    }, { rootMargin: '-10% 0px -75% 0px' });
    document.querySelectorAll('.prose h2[id]').forEach(function (h) { io.observe(h); });
  })();
</script>
