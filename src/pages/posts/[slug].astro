---
import { render } from 'astro:content';
import Note from '../../layouts/Note.astro';
import { getNotes, type Note as NoteEntry } from '../../lib/notes';

export async function getStaticPaths() {
  const notes = await getNotes();
  return notes.map((note) => ({ params: { slug: note.id }, props: { note, all: notes } }));
}

interface Props {
  note: NoteEntry;
  all: NoteEntry[];
}

const { note, all } = Astro.props;
const { Content, headings } = await render(note);
---

<Note note={note} all={all} headings={headings}>
  <Content />
</Note>
